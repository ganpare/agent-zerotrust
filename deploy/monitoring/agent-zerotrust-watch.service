[Unit]
Description=agent-zerotrust: session watcher (auto review + Telegram briefing)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=sungo
WorkingDirectory=/mnt/ssd2tb/projects/Zero-trust
# -u: unbuffered stdout so watcher lines reach the journal immediately
ExecStart=/usr/bin/python3 -u -m evidence.watch --interval 60
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target

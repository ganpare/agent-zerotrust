[Unit]
Description=agent-zerotrust: MCP approvals server (agent-facing control plane)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=sungo
WorkingDirectory=/mnt/ssd2tb/projects/Zero-trust
ExecStart=/usr/bin/python3 -u -m approvals.mcp_server
Environment=APPROVAL_PORT=8930
Environment=WARGATE_URL=https://127.0.0.1:8888
Environment=APPROVAL_BIND=0.0.0.0
Environment=INFISICAL_URL=http://<INFISICAL_HOST>:8088
Environment=INFISICAL_PROJECT=<INFISICAL_PROJECT>
Environment=INFISICAL_CRED_DIR=/home/<USER>/.config/infisical
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

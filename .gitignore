# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Secrets & credentials — this project is about guarding them;
# never commit real keys, tokens, or captured evidence.
*.pem
*.key
.env
.env.*

# Captured evidence / recordings (may contain secrets) — the real data
# lives under deploy/*/state/ (ignored below); these anchors only guard
# against stray top-level dumps with those exact names.
/recordings/

# Local deployment state
deploy/*/local/

# Runtime state (keys, passwords, cookies, recordings, DB) — never commit
deploy/*/state/

# Python bytecode
__pycache__/
*.py[cod]
